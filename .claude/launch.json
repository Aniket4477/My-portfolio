{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server,socketserver;socketserver.TCPServer.allow_reuse_address=True;p=int(os.environ.get('PORT','8137'));socketserver.TCPServer(('127.0.0.1',p),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "port": 8137,
      "autoPort": true
    }
  ]
}
